{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "elean",
  "colors": {
    "primary": "#80b85c",
    "light": "#80b85c",
    "dark": "#80b85c"
  },
  "favicon": "/images/favicon.ico",
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "Changelog",
          "icon": "book-open-cover",
          "href": "https://elean.app/changelog"
        }
      ]
    },
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Getting started",
            "pages": [
              "index",
              "quickstart",
              "development"
            ]
          },
          {
            "group": "Customization",
            "hidden": true,
            "pages": [
              "essentials/settings",
              "essentials/navigation"
            ]
          },
          {
            "group": "Writing content",
            "hidden": true,
            "pages": [
              "essentials/markdown",
              "essentials/code",
              "essentials/images",
              "essentials/reusable-snippets"
            ]
          },
          {
            "group": "AI tools",
            "hidden": true,
            "pages": [
              "ai-tools/cursor",
              "ai-tools/claude-code",
              "ai-tools/windsurf"
            ]
          },
          {
            "group": "AI agents (MCP)",
            "pages": [
              "mcp/overview",
              "mcp/installation",
              "mcp/tools"
            ]
          },
          {
            "group": "Integrations",
            "pages": [
              "integrations/discord",
              "integrations/webhook"
            ]
          }
        ]
      },
      {
        "tab": "API reference",
        "groups": [
          {
            "group": "API documentation",
            "pages": [
              "api-reference/introduction"
            ]
          },
          {
            "group": "Endpoints",
            "openapi": "api-reference/api.json"
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/images/logo-standard.svg",
    "dark": "/images/logo-alt.svg"
  },
  "navbar": {
    "links": [],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://dashboard.mintlify.com"
    }
  },
  "contextual": {
    "options": [
     "copy",
     "view",
     "chatgpt",
     "claude",
     "perplexity",
     "mcp",
     "cursor",
     "vscode"
   ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/elean_app",
      "discord": "https://discord.gg/elean"
    }
  },
  "appearance": {
    "default": "dark",
    "strict": true
  }
}
